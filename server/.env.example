# Study Library Operating System - Server Environment Variables
PORT=8000
NODE_ENV=production

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/library_management

# Security & Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_here_minimum_32_characters

# Client SaaS URL (Allowed for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Razorpay Payment Gateway (for SaaS plan upgrades & online fee payments)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
